# --- Окружение ---
ENV=development
DEBUG=False

# --- База данных PostgreSQL ---
# Для локального запуска вне докера используйте localhost
# Внутри Docker Compose хост переопределится на 'db'
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sirius_db
DB_USERNAME=your_db_user
DB_PASSWORD=your_secure_db_password

# --- Redis (Кэш и Rate Limiter) ---
# Для локального запуска без пароля: redis://localhost:6379
# С паролем: redis://:your_redis_password@localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# --- Безопасность (Security) ---
# Секретный ключ для подписи сессий и куки (сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your_very_long_and_random_secret_key_here
# Разрешенные хосты (через запятую, НЕ используйте '*' в production)
ALLOWED_HOSTS=localhost,127.0.0.1
# Доверенные прокси (X-Forwarded-For принимается только от них).
# В деве достаточно loopback. В прод: перечислить IP/CIDR nginx-контейнеров и/или
# reverse-proxy сети Docker, иначе rate-limit будет считать всех через один IP.
# Пример для типового docker-compose: 127.0.0.1,::1,172.17.0.1,172.18.0.0/16
TRUSTED_PROXY_IPS=127.0.0.1,::1

# --- JWT (API аутентификация) ---
# Секретные ключи для JWT-токенов (сгенерируйте уникальные для каждого)
API_SECRET_KEY=your_api_secret_key_here
API_REFRESH_SECRET_KEY=your_api_refresh_secret_key_here
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Шифрование сообщений поддержки (Fernet) ---
# Сообщения чата поддержки и вложения шифруются в БД/хранилище этим ключом.
# Если не задан — хранятся в открытом виде (в проде ОБЯЗАТЕЛЬНО задать).
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ВАЖНО: ключ должен быть постоянным и сохранён в надёжном месте — при его
# потере ранее зашифрованные сообщения/вложения восстановить нельзя.
SUPPORT_ENCRYPTION_KEY=your_support_encryption_key_here

# --- Почтовый сервер (SMTP) ---
# Настройки для отправки кодов сброса пароля
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_USERNAME=your_support_email@yandex.ru
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=your_support_email@yandex.ru
MAIL_TIMEOUT=30
MAIL_USE_SSL=true
MAIL_USE_STARTTLS=false
MAIL_DEV_LOG_CODES=false
# Получатели уведомлений о новых баг-репортах, через запятую
BUG_REPORT_NOTIFICATION_EMAILS=admin@example.com
BUG_REPORT_DASHBOARD_URL=https://sirius-achievements.ru/sirius.achievements/app/moderation/bug-reports

# --- AI / OCR настройки ---
# Локальная LLM (Qwen2.5-7B-Instruct-AWQ через vLLM, OpenAI-совместимый API)
# Внутри Docker Compose используется адрес сервиса vllm; для запуска вне докера
# укажите реальный адрес сервера vLLM (например, http://localhost:8000/v1)
LOCAL_LLM_BASE_URL=http://vllm:8000/v1
LOCAL_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT=60
# Включить локальную LLM для генерации AI-сводки (требует запущенный сервис vllm)
RESUME_LOCAL_AI_ENABLED=False
# Разрешить скачивание моделей OCR (False = использовать только предустановленные в ./models/)
RESUME_OCR_MODEL_DOWNLOAD_ENABLED=False

# --- Системные настройки ---
# Часовой пояс сервера
TZ=Europe/Moscow
